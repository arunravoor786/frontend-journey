interface IUFSGridProps {
  folders: IFolderItem[];
  onCreateFolder: () => void;
  onEditFolder: (folder: IFolderItem) => void;
  onDeleteFolder: (folderId: string) => void;
  onManageTeam: () => void;
  onRefresh: () => void;
  loading?: boolean;
