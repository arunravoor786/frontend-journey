// Custom cell renderers
const StatusCellRenderer = (params: any) => {
  const status = params.value;
  let className = '';
  let color: 'default' | 'primary' | 'secondary' | 'error' | 'info' | 'success' | 'warning' = 'default';
  
  switch (status) {
    case 'Created':
      className = styles.created;
      color = 'success';
      break;
    case 'In Progress':
      className = styles.inProgress;
      color = 'warning';
      break;
    case 'Not Created':
      className = styles.notCreated;
      color = 'error';
      break;
    default:
      color = 'default';
  }
  
  return (
    <Chip
      label={status}
      size="small"
      color={color}
      className={className}
    />
  );
};

const LifecycleCellRenderer = (params: any) => {
  const lifecycle = params.value;
  let className = '';
  let color: 'default' | 'primary' | 'secondary' = 'default';
  
  switch (lifecycle) {
    case 'Pursuit':
      className = styles.pursuit;
      color = 'primary';
      break;
    case 'Pre-Construction':
    case 'SPW Pre-Construction':
      className = styles.preConstruction;
      color = 'secondary';
      break;
    case 'Construction':
    case 'SPW Construction':
      className = styles.construction;
      color = 'primary';
      break;
    case 'MARCOM':
      className = styles.marcom;
      color = 'secondary';
      break;
    default:
      className = styles.other;
      color = 'default';
  }
  
  return (
    <Chip
      label={lifecycle}
      size="small"
      color={color}
      className={className}
    />
  );
};

const ActionsCellRenderer = (params: any) => {
  const folder: IFolderItem = params.data;
  
  const handleEdit = () => {
    params.context.onEdit(folder);
  };
  
  const handleDelete = () => {
    params.context.onDelete(folder.id);
  };
  
  return (
    <Box display="flex" gap={1}>
      <Tooltip title="Edit Folder">
        <IconButton size="small" onClick={handleEdit}>
          <Edit fontSize="small" />
        </IconButton>
      </Tooltip>
      
      <Tooltip title="Delete Folder">
        <IconButton size="small" color="error" onClick={handleDelete}>
          <Delete fontSize="small" />
        </IconButton>
      </Tooltip>
      
      {folder.boxFolderId && (
        <Tooltip title="Open in Box">
          <IconButton
            size="small"
            color="primary"
            onClick={() => window.open(`https://dpr.app.box.com/folder/${folder.boxFolderId}`, '_blank')}
          >
            <Folder fontSize="small" />
          </IconButton>
        </Tooltip>
      )}
    </Box>
  );
};

const BooleanCellRenderer = (params: any) => {
  return params.value ? '✓' : '';
};

export const UFSGrid: React.FC<IUFSGridProps> = ({
  folders,
  onCreateFolder,
  onEditFolder,
  onDeleteFolder,
  onManageTeam,
  onRefresh,
  loading = false
}) => {
  const [gridApi, setGridApi] = useState<GridApi | null>(null);
  const [selectedRows, setSelectedRows] = useState<IFolderItem[]>([]);
  const [deleteConfirmDialog, setDeleteConfirmDialog] = useState<{
    open: boolean;
    folderId: string;
    folderName: string;
  }>({
    open: false,
    folderId: '',
    folderName: ''
  });

  // Column definitions
  const columnDefs: ColDef[] = useMemo(() => [
    {
      field: 'lifecycle',
      headerName: 'Lifecycle',
      width: 150,
      cellRenderer: LifecycleCellRenderer,
      filter: true,
      sortable: true
    },
    {
      field: 'folderName',
      headerName: 'Folder Name',
      width: 300,
      filter: 'agTextColumnFilter',
      sortable: true,
      resizable: true
    },
    {
      field: 'isMainProject',
      headerName: 'Main Project',
      width: 120,
      cellRenderer: BooleanCellRenderer,
      filter: 'agSetColumnFilter',
      sortable: true
    },
    {
      field: 'spw',
      headerName: 'SPW',
      width: 80,
      cellRenderer: BooleanCellRenderer,
      filter: 'agSetColumnFilter',
      sortable: true
    },
    {
      field: 'marcom',
      headerName: 'MARCOM',
      width: 100,
      cellRenderer: BooleanCellRenderer,
      filter: 'agSetColumnFilter',
      sortable: true
    },
    {
      field: 'vdc',
      headerName: 'VDC',
      width: 80,
      cellRenderer: BooleanCellRenderer,
      filter: 'agSetColumnFilter',
      sortable: true
    },
    {
      field: 'prefab',
      headerName: 'PREFAB',
      width: 100,
      cellRenderer: BooleanCellRenderer,
      filter: 'agSetColumnFilter',
      sortable: true
    },
    {
      field: 'bura',
      headerName: 'BURA',
      width: 90,
      cellRenderer: BooleanCellRenderer,
      filter: 'agSetColumnFilter',
      sortable: true
    },
    {
      field: 'cra',
      headerName: 'CRA',
      width: 80,
      cellRenderer: BooleanCellRenderer,
      filter: 'agSetColumnFilter',
      sortable: true
    },
    {
      field: 'status',
      headerName: 'Status',
      width: 120,
      cellRenderer: StatusCellRenderer,
      filter: 'agSetColumnFilter',
      sortable: true
    },
    {
      field: 'createdAt',
      headerName: 'Created',
      width: 120,
      valueFormatter: (params) => {
        if (params.value) {
          return new Date(params.value).toLocaleDateString();
        }
        return '';
      },
      filter: 'agDateColumnFilter',
      sortable: true
    },
    {
      field: 'createdBy',
      headerName: 'Created By',
      width: 150,
      filter: 'agTextColumnFilter',
      sortable: true
    },
    {
      headerName: 'Actions',
      width: 120,
      cellRenderer: ActionsCellRenderer,
      sortable: false,
      filter: false,
      pinned: 'right'
    }
  ], []);

  // Grid context for passing callbacks to cell renderers
  const gridContext = useMemo(() => ({
    onEdit: onEditFolder,
