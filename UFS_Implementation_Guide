// UFSForm.tsx - Main wrapper component for UFS application (UPDATED)
import React, { useState, useEffect, useCallback } from 'react';
import {
  Box,
  Alert,
  CircularProgress,
  Typography,
  Snackbar,
  IconButton,
  Breadcrumbs,
  Link,
  Divider
} from '@mui/material';
import {
  Close,
  Home,
  FolderOutlined
} from '@mui/icons-material';

//   IMPORT PCU's ProjectInformation component instead of custom one
import { ProjectInformation } from '../../Home/ProjectInformation';

import { UFSGrid } from './UFSGrid';
import { FolderCreationDialog } from './FolderCreationDialog';
import { TeamManagementDialog } from './TeamManagementDialog';
import UFSController from './UFSController';
import { 
  IUFSProps, 
  IFolderItem, 
  ITeamMember, 
  IUFSFormData 
} from './UFSTypes';
import { useGetUserInfo } from '../../../../CustomHooks/useGetUserInfo';
import styles from './Styles/UFS.module.scss';

interface IUFSFormState {
  loading: boolean;
  error: string | null;
  folders: IFolderItem[];
  teamMembers: ITeamMember[];
  showFolderDialog: boolean;
  showTeamDialog: boolean;
  snackbarOpen: boolean;
  snackbarMessage: string;
  snackbarSeverity: 'success' | 'error' | 'warning' | 'info';
}

export const UFSForm: React.FC<IUFSProps> = ({
  projectId,
  pirData, //   Using PCU's project data structure
  onSave,
  onCancel,
  readonly = false
}) => {
  const userInfo = useGetUserInfo();

  // Component state
  const [state, setState] = useState<IUFSFormState>({
    loading: true,
    error: null,
    folders: [],
    teamMembers: [],
    showFolderDialog: false,
    showTeamDialog: false,
    snackbarOpen: false,
    snackbarMessage: '',
    snackbarSeverity: 'info'
  });

  // Update state helper
  const updateState = useCallback((updates: Partial<IUFSFormState>) => {
    setState(prev => ({ ...prev, ...updates }));
  }, []);

  // Show notification
  const showNotification = useCallback((message: string, severity: IUFSFormState['snackbarSeverity'] = 'info') => {
    updateState({
      snackbarOpen: true,
      snackbarMessage: message,
      snackbarSeverity: severity
    });
  }, [updateState]);

  //   UPDATED: Load folder data only (PCU handles project data)
  const loadFolderData = useCallback(async () => {
    if (!pirData?.PROJECT_NUMBER && !pirData?.OPPORTUNITY_NUMBER) {
      updateState({
        loading: false,
        error: 'No project number available'
      });
      return;
    }

    try {
      updateState({ loading: true, error: null });

      const projectNumber = pirData.PROJECT_NUMBER || pirData.OPPORTUNITY_NUMBER;
      const result = await UFSController.loadFolderHistory(projectNumber);

      if (result.error) {
        throw new Error(result.error);
      }

      updateState({
        loading: false,
        folders: result.folders,
        error: null
      });

    } catch (error) {
      console.error('Error loading UFS folder data:', error);
      updateState({
        loading: false,
        error: error instanceof Error ? error.message : 'Failed to load folder data'
      });
      showNotification('Failed to load folder data', 'error');
    }
  }, [pirData, updateState, showNotification]);

  // Handle folder creation
  const handleCreateFolder = useCallback(() => {
    updateState({ showFolderDialog: true });
  }, [updateState]);

  //   UPDATED: Handle folder creation submit using PCU data
  const handleFolderCreated = useCallback(async (folderData: any) => {
    try {
      updateState({ showFolderDialog: false });
      showNotification('Creating folder...', 'info');

      const result = await UFSController.createFolder(
        folderData.folderType,
        pirData, //   Pass PCU's project data
        folderData.additionalData
      );

      if (result.success) {
        showNotification('Folder created successfully', 'success');
        // Reload folder data
        await loadFolderData();
      } else {
        throw new Error(result.error || 'Failed to create folder');
      }

    } catch (error) {
      console.error('Error creating folder:', error);
      showNotification(
        error instanceof Error ? error.message : 'Failed to create folder',
        'error'
      );
    }
  }, [pirData, updateState, showNotification, loadFolderData]);

  // Handle folder edit
  const handleEditFolder = useCallback((folder: IFolderItem) => {
    showNotification(`Edit functionality for ${folder.folderName} - Coming Soon`, 'info');
  }, [showNotification]);

  // Handle folder delete
  const handleDeleteFolder = useCallback(async (folderId: string) => {
    try {
      const folder = state.folders.find(f => f.id === folderId);
      if (!folder) {
        throw new Error('Folder not found');
      }

      showNotification(`Deleting ${folder.folderName}...`, 'info');

      // This would call a delete service
      // await UFSService.deleteFolder(folderId);

      showNotification('Folder deleted successfully', 'success');
      await loadFolderData();

    } catch (error) {
      console.error('Error deleting folder:', error);
      showNotification(
        error instanceof Error ? error.message : 'Failed to delete folder',
        'error'
      );
    }
  }, [state.folders, showNotification, loadFolderData]);

  // Handle team management
  const handleManageTeam = useCallback(() => {
    updateState({ showTeamDialog: true });
  }, [updateState]);

  // Handle team update
  const handleTeamUpdated = useCallback(async (teamData: ITeamMember[]) => {
    try {
      updateState({ showTeamDialog: false, teamMembers: teamData });
      showNotification('Team updated successfully', 'success');
    } catch (error) {
      console.error('Error updating team:', error);
      showNotification('Failed to update team', 'error');
    }
  }, [updateState, showNotification]);

  // Handle data refresh
  const handleRefresh = useCallback(() => {
    loadFolderData();
  }, [loadFolderData]);

  //   UPDATED: Handle save (no project data in form data)
  const handleSave = useCallback(() => {
    if (onSave) {
      const formData: IUFSFormData = {
        folders: state.folders,
        teamMembers: state.teamMembers
      };
      onSave(formData);
    }
  }, [onSave, state.folders, state.teamMembers]);

  // Load data on mount
  useEffect(() => {
    loadFolderData();
  }, [loadFolderData]);

  // Close snackbar
  const handleCloseSnackbar = useCallback(() => {
    updateState({ snackbarOpen: false });
  }, [updateState]);

  // Render loading state
  if (state.loading) {
    return (
      <Box className={styles.ufsContainer}>
        <Box display="flex" justifyContent="center" alignItems="center" minHeight="400px">
          <CircularProgress size={60} />
          <Typography variant="h6" sx={{ ml: 2 }}>
            Loading UFS Application...
          </Typography>
        </Box>
      </Box>
    );
  }

  // Render error state
  if (state.error) {
    return (
      <Box className={styles.ufsContainer}>
        <Alert 
          severity="error" 
          sx={{ mb: 2 }}
          action={
            <IconButton size="small" onClick={onCancel}>
              <Close />
            </IconButton>
          }
        >
          <Typography variant="h6">Error Loading UFS Application</Typography>
          <Typography>{state.error}</Typography>
        </Alert>
      </Box>
    );
  }

  //   UPDATED: Render no data state using PCU data
  if (!pirData) {
    return (
      <Box className={styles.ufsContainer}>
        <Alert severity="warning" sx={{ mb: 2 }}>
          <Typography variant="h6">No Project Data Available</Typography>
          <Typography>
            Unable to load project information. Please verify the project exists and try again.
          </Typography>
        </Alert>
      </Box>
    );
  }

  return (
    <Box className={styles.ufsContainer}>
      {/* Breadcrumbs */}
      <Breadcrumbs sx={{ mb: 3 }}>
        <Link 
          component="button" 
          variant="body1" 
          onClick={onCancel}
          sx={{ display: 'flex', alignItems: 'center', textDecoration: 'none' }}
        >
          <Home sx={{ mr: 0.5, fontSize: 20 }} />
          Project Setup
        </Link>
        <Typography 
          variant="body1" 
          color="text.primary"
          sx={{ display: 'flex', alignItems: 'center' }}
        >
          <FolderOutlined sx={{ mr: 0.5, fontSize: 20 }} />
          Unified Folder Structure
        </Typography>
      </Breadcrumbs>

      {/* Info Alert */}
      <Alert severity="info" sx={{ mb: 3 }}>
        <Typography variant="body2">
          Click{' '}
          <Link 
            href="https://dprprod.sharepoint.com/sites/toolbox/Pages/ApplicationDatabase.aspx?app=UFS" 
            target="_blank" 
            rel="noopener noreferrer"
          >
            here
          </Link>{' '}
          to learn more about the Unified Folder Structure.
        </Typography>
      </Alert>

      {/*   USE PCU's ProjectInformation Component */}
      <ProjectInformation pirData={pirData} />

      <Divider sx={{ my: 3 }} />

      {/* UFS Grid */}
      <UFSGrid
        folders={state.folders}
        onCreateFolder={readonly ? () => {} : handleCreateFolder}
        onEditFolder={readonly ? () => {} : handleEditFolder}
        onDeleteFolder={readonly ? () => {} : handleDeleteFolder}
        onManageTeam={readonly ? () => {} : handleManageTeam}
        onRefresh={handleRefresh}
        loading={state.loading}
      />

      {/* Action Buttons */}
      <Box className={styles.actionButtons}>
        <button
          type="button"
          onClick={onCancel}
          className="btn btn-secondary"
        >
          {readonly ? 'Close' : 'Cancel'}
        </button>
        {!readonly && (
          <button
            type="button"
            onClick={handleSave}
            className="btn btn-primary"
            disabled={state.folders.length === 0}
          >
            Save Configuration
          </button>
        )}
      </Box>

      {/* Dialogs */}
      {state.showFolderDialog && (
        <FolderCreationDialog
          open={state.showFolderDialog}
          pirData={pirData} //   Pass PCU's project data
          onClose={() => updateState({ showFolderDialog: false })}
          onSubmit={handleFolderCreated}
        />
      )}

      {state.showTeamDialog && (
        <TeamManagementDialog
          open={state.showTeamDialog}
          teamMembers={state.teamMembers}
          onClose={() => updateState({ showTeamDialog: false })}
          onSubmit={handleTeamUpdated}
        />
      )}

      {/* Notification Snackbar */}
      <Snackbar
        open={state.snackbarOpen}
        autoHideDuration={6000}
        onClose={handleCloseSnackbar}
        anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}
      >
        <Alert 
          onClose={handleCloseSnackbar} 
          severity={state.snackbarSeverity} 
          sx={{ width: '100%' }}
        >
          {state.snackbarMessage}
        </Alert>
      </Snackbar>
    </Box>
  );
};

export default UFSForm;
